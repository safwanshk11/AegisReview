# Backend
GITHUB_TOKEN=
GEMINI_API_KEY=
AEGIS_LLM_MODEL=gemini-flash-latest
# Optional: caps how many findings get AI review per scan. Unset = review all of
# them, which is fine on a free Gemini key until you hit its daily quota, then the
# rest are cleanly skipped (not retried). Set a number to cap cost on huge repos.
AEGIS_REVIEW_LIMIT=
ALLOWED_ORIGINS=http://localhost:5173
# Optional: allow all matching origins by regex (handy for Vercel preview URLs
# that change each deploy). Example: https://aegis-frontend.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Frontend (copy the relevant value to frontend/.env)
VITE_API_URL=http://localhost:8000
